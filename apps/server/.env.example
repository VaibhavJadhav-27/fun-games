# Admin dashboard at /admin. Leave either empty to switch it off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-12-plus-characters

# Proxies in front of the server (Render: 1). Per-IP limits then use X-Forwarded-For.
# Leave unset locally.
# TRUST_PROXY=1

# Games released at startup (comma-separated). Unset = every built game.
# The admin page can switch them on and off until the next restart.
# RELEASED_GAMES=imposter,traitor
